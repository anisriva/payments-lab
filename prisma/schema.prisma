generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  headers    Json
  rawBody    String
  receivedAt DateTime @default(now())

  @@index([provider, receivedAt])
}