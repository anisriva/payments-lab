@baseUrl = http://localhost:3000
@premiumPlanPriceId = 330a6214-6ae1-492c-a008-9fdef9bcfb21

### 201 — start a subscription (check instruction.options.subscription_id starts with "sub_")
# MCP check: SELECT status, provider_subscription_id FROM subscriptions ORDER BY created_at DESC LIMIT 1;
# @name startSubscription
POST {{baseUrl}}/api/platform/payments/subscriptions
Content-Type: application/json

{"gateway":"razorpay","payerCountry":"IN","planPriceId":"{{premiumPlanPriceId}}"}

### 200 — sync the subscription
# MCP check: SELECT status FROM subscriptions ORDER BY created_at DESC LIMIT 1;
GET {{baseUrl}}/api/platform/payments/subscriptions/{{startSubscription.response.body.$.data.recordId}}

### 200 — list all subscriptions
# MCP check: SELECT status, provider_subscription_id FROM subscriptions ORDER BY created_at DESC LIMIT 10;
GET {{baseUrl}}/api/platform/payments/subscriptions

### 400 — confirm with fake signature (InvalidPaymentSignatureError)
POST {{baseUrl}}/api/platform/payments/subscriptions/{{startSubscription.response.body.$.data.recordId}}/confirm
Content-Type: application/json

{"paymentId":"pay_fake","signature":"deadbeef"}

### 404 — random UUID planPriceId (PlanPriceNotFoundError)
POST {{baseUrl}}/api/platform/payments/subscriptions
Content-Type: application/json

{"gateway":"razorpay","payerCountry":"IN","planPriceId":"00000000-0000-4000-8000-000000000000"}

### 200 — refresh subscription status from Razorpay
POST {{baseUrl}}/api/platform/payments/subscriptions/{{startSubscription.response.body.$.data.recordId}}/refresh

### 200 — cancel immediately (only after Step 5, on an active subscription)
# MCP check: SELECT status, cancel_at_cycle_end, canceled_at FROM subscriptions ORDER BY created_at DESC LIMIT 1;
POST {{baseUrl}}/api/platform/payments/subscriptions/{{startSubscription.response.body.$.data.recordId}}/cancel
Content-Type: application/json

{"atCycleEnd":false}

### 200 — cancel at cycle end (only after Step 5, on an active subscription)
# MCP check: SELECT status, cancel_at_cycle_end, canceled_at FROM subscriptions ORDER BY created_at DESC LIMIT 1;
POST {{baseUrl}}/api/platform/payments/subscriptions/{{startSubscription.response.body.$.data.recordId}}/cancel
Content-Type: application/json

{"atCycleEnd":true}
